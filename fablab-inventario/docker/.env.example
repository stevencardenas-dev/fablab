# Copiar a docker/.env (NO va al repositorio) y poner valores largos y aleatorios:
#   openssl rand -hex 24
MYSQL_ROOT_PASSWORD=cambia-esto
MYSQL_APP_PASSWORD=cambia-esto
# Token de herramientas (scripts). La app web NO lo recibe.
API_TOKEN=cambia-esto
# Cuenta compartida del laboratorio que usa la app. Generar el hash con:
#   read -s -p "Clave: " CLAVE; echo
#   CLAVE="$CLAVE" node -e "import('./server/sesion.mjs').then(m=>console.log(m.crearHashClave(process.env.CLAVE)))"
#   unset CLAVE
CUENTA_USUARIO=laboratorio
CUENTA_CLAVE_HASH=cambia-esto
# Firma de las sesiones (openssl rand -hex 32)
SESION_SECRETO=cambia-esto
# Puerto publicado en el servidor (el proxy HTTPS apunta aquí)
WEB_PORT=8080
# Versión de las imágenes de ghcr.io. "estable" sigue la última publicada (y la
# actualiza el cron de README); un tag fijo (v1.2.0) congela la versión.
# APP_VERSION=estable
# Límite de escrituras por IP y minuto (429 si se supera). Por defecto 120.
# LIMITE_ESCRITURAS_MIN=120
# Turnstile (Cloudflare captcha del login). Sin esto el login funciona sin captcha.
# - Sitekey PÚBLICO: se hornea en el bundle web en el build (EXPO_PUBLIC_*),
#   por eso es un build-arg del servicio web. Widget: modo managed, action "login",
#   dominios localhost + 127.0.0.1 + el dominio de producción.
# - Secret: SOLO vive en el server (aquí / Render), nunca en el repo ni en el bundle.
# - Hostnames: lista de dominios del frontend donde corre el widget. OBLIGATORIA junto
#   al secret: si pones TURNSTILE_SECRET pero dejas esta lista vacía (o sin incluir
#   el dominio del servidor), el login se queda BLOQUEADO (fail-closed). Si usas
#   Turnstile en producción, pon aquí los dominios reales (y quita localhost).
#   Para el común el login funciona sin captcha (ambos vacíos): déjalos así.
EXPO_PUBLIC_TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
