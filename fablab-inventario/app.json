{
  "expo": {
    "name": "fablab-inventario",
    "slug": "fablab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fablabinventario",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.fablabufps.inventario",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "pwa": {
        "manifest": "./public/manifest.json",
        "splash": {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "backgroundColor": "#208AEF"
        },
        "themeColor": "#C8102E",
        "orientation": "portrait",
        "icons": [
          {
            "src": "./assets/images/icon.png",
            "sizes": "any"
          }
        ]
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "FabLab necesita la cámara para escanear el código Data Matrix de los elementos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FabLab necesita acceso a tus fotos para elegir una imagen del elemento.",
          "cameraPermission": "FabLab necesita la cámara para tomar una foto del elemento."
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "289400ee-11a5-4feb-9d30-63b1aa36703a"
      }
    },
    "owner": "masterp06s-team"
  }
}
