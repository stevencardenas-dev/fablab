{
  "expo": {
    "name": "fablab-inventario",
    "slug": "fablab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fablabinventario",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.fablabufps.inventario",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "pwa": {
        "manifest": "./public/manifest.json",
        "splash": {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 300,
          "backgroundColor": "#FFFFFF"
        },
        "themeColor": "#C8102E",
        "orientation": "portrait",
        "icons": [
          {
            "src": "./icon-192.png",
            "sizes": "192x192",
            "type": "image/png"
          },
          {
            "src": "./icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any maskable"
          }
        ]
      }
    },
    "plugins": [
      "expo-updates",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 300
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "FabLab necesita la cámara para escanear el código Data Matrix de los elementos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FabLab necesita acceso a tus fotos para elegir una imagen del elemento.",
          "cameraPermission": "FabLab necesita la cámara para tomar una foto del elemento."
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "updates": {
      "url": "https://u.expo.dev/289400ee-11a5-4feb-9d30-63b1aa36703a",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "universidad"
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "289400ee-11a5-4feb-9d30-63b1aa36703a"
      }
    },
    "owner": "masterp06s-team"
  }
}
